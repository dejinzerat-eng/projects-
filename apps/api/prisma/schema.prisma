generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum ListingStatus {
  DRAFT
  PENDING
  ACTIVE
  RESERVED
  SOLD
  EXPIRED
  REJECTED
  DELETED
}

enum Condition {
  NEW
  LIKE_NEW
  USED
  DAMAGED
}

enum OfferType {
  SELL
  BUY
  EXCHANGE
  GIVE
  RENT
}

enum ReportTarget {
  LISTING
  USER
  MESSAGE
  CONVERSATION
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum TokenType {
  EMAIL_VERIFY
  PHONE_VERIFY
  PASSWORD_RESET
  EMAIL_CHANGE
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String?
  name            String
  phone           String?
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  googleId        String?    @unique
  appleId         String?    @unique
  avatarUrl       String?
  bio             String?
  city            String?
  region          String?
  isBusiness      Boolean    @default(false)
  companyName     String?
  companyId       String? // IČO
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lastSeenAt      DateTime?
  /// Souhlas s podmínkami při registraci (čas a verze podmínek)
  termsAcceptedAt DateTime?
  termsVersion    String?
  /// Uzamčení účtu po opakovaných chybných heslech (nezávisle na IP)
  failedLogins      Int       @default(0)
  lastFailedLoginAt DateTime?
  lockedUntil       DateTime?
  /// Telefon se u inzerátů ukáže jen s výslovným souhlasem (a jen ověřený)
  showPhone         Boolean   @default(false)
  /// Firma ověřená v registru ARES (obchodní jméno a sídlo z ARES)
  companyVerifiedAt DateTime?
  companyAddress    String?
  vatId             String? // DIČ

  listings        Listing[]
  favorites       Favorite[]
  following       FollowSeller[]  @relation("follower")
  followers       FollowSeller[]  @relation("seller")
  savedSearches   SavedSearch[]
  buyerConvs      Conversation[]  @relation("buyer")
  sellerConvs     Conversation[]  @relation("seller")
  messages        Message[]
  blocks          Block[]         @relation("blocker")
  blockedBy       Block[]         @relation("blocked")
  reports         Report[]        @relation("reporter")
  reviewsGiven    Review[]        @relation("author")
  reviewsReceived Review[]        @relation("sellerReviews")
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  tokens          VerificationToken[]
  auditLogs       AuditLog[]
}

model Category {
  id             String     @id @default(cuid())
  slug           String
  name           String
  icon           String?
  position       Int        @default(0)
  parentId       String?
  parent         Category?  @relation("tree", fields: [parentId], references: [id])
  children       Category[] @relation("tree")
  /// Definice filtrů/parametrů (FilterDef[]) – spravuje se v administraci
  filters        Json       @default("[]")
  active         Boolean    @default(true)
  seoTitle       String?
  seoDescription String?
  listings       Listing[]

  @@unique([parentId, slug])
  @@index([parentId])
}

model Listing {
  id               String        @id @default(cuid())
  slug             String
  title            String
  description      String
  price            Int?
  priceNegotiable  Boolean       @default(false)
  currency         String        @default("CZK")
  condition        Condition?
  offerType        OfferType     @default(SELL)
  status           ListingStatus @default(ACTIVE)
  rejectReason     String?
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  city             String
  region           String
  zip              String?
  lat              Float?
  lng              Float?
  /// Hodnoty parametrů kategorie, např. {"brand":"Škoda","year":2018}
  attributes       Json          @default("{}")
  videoUrl         String?
  views            Int           @default(0)
  spamScore        Int           @default(0)
  publishedAt      DateTime?
  expiresAt        DateTime?
  expiryNotifiedAt DateTime?
  bumpedAt         DateTime?
  highlightedUntil DateTime?
  topUntil         DateTime?
  /// Doba vyplnění průvodce od otevření po zveřejnění (s)
  composeSeconds   Int?
  /// Otisk normalizovaného názvu a popisu pro hledání duplicit
  contentHash      String?
  /// Důvody automatické kontroly (pro moderátora)
  riskReasons      Json          @default("[]")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  /// Normalizovaný text pro hledání (malá písmena bez diakritiky: název + popis + parametry + město),
  /// udržuje aplikace (buildSearchText v @dej/shared); GIN trigram index pro hledání v PostgreSQL
  searchText       String        @default("")

  images        ListingImage[]
  favorites     Favorite[]
  conversations Conversation[]

  @@index([status, categoryId])
  @@index([userId, status])
  @@index([expiresAt])
  @@index([contentHash])
  @@index([status, publishedAt])
  @@index([lat, lng])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  ownerId   String
  url       String
  thumbUrl  String
  width     Int
  height    Int
  position  Int     @default(0)
  /// Percepční otisk fotky (dHash, 64 bitů) pro hledání znovu použitých fotek
  phash     BigInt?
  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([phash])
}

model Favorite {
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
  @@index([listingId])
}

model FollowSeller {
  followerId String
  sellerId   String
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  seller     User     @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, sellerId])
}

model SavedSearch {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  /// Parametry hledání (q, category, priceMin, priceMax, city, radius, …)
  query          Json
  notify         Boolean   @default(true)
  lastCheckedAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model Conversation {
  id            String    @id @default(cuid())
  /// Bez inzerátu = konverzace zahájená z profilu uživatele
  listingId     String?
  listing       Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  /// Jen u konverzací bez inzerátu: "menšíId:většíId" – jedna přímá konverzace na dvojici uživatelů
  directKey     String?   @unique
  buyerId       String
  buyer         User      @relation("buyer", fields: [buyerId], references: [id])
  sellerId      String
  seller        User      @relation("seller", fields: [sellerId], references: [id])
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  /// Archivace zvlášť pro každého účastníka
  buyerArchivedAt  DateTime?
  sellerArchivedAt DateTime?
  messages      Message[]
  reviews       Review[]
  attachments   MessageAttachment[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  imageUrl       String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  attachment     MessageAttachment?

  @@index([conversationId, createdAt])
}

model Block {
  blockerId String
  blockedId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  reporter     User         @relation("reporter", fields: [reporterId], references: [id])
  targetType   ReportTarget
  targetId     String
  /// Konverzace, které se hlášení týká (CONVERSATION a MESSAGE) – moderátor ji smí zobrazit jen ke čtení
  conversationId String?
  reason       String
  note         String?
  status       ReportStatus @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([status])
}

/// Hodnocení je možné jen po skutečné konverzaci (vazba na Conversation).
model Review {
  id             String       @id @default(cuid())
  authorId       String
  author         User         @relation("author", fields: [authorId], references: [id])
  sellerId       String
  seller         User         @relation("sellerReviews", fields: [sellerId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  rating         Int
  text           String?
  createdAt      DateTime     @default(now())

  @@unique([authorId, conversationId])
  @@index([sellerId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  /// Zařízení pro přehled přihlášení v nastavení
  userAgent  String?
  ip         String?
  lastUsedAt DateTime?

  @@index([userId])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  /// Ověřovaná hodnota (nové telefonní číslo nebo nový e-mail)
  target    String?
  /// Počet chybně zadaných kódů
  attempts  Int       @default(0)

  @@index([userId, type])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Informační stránky (Podmínky, GDPR, Nápověda…) – editovatelné v administraci
model Page {
  slug      String   @id
  title     String
  content   String
  updatedAt DateTime @updatedAt
}

/// Ceník placených služeb (topování, zvýraznění…) – nastavitelný v administraci (fáze 2: platby)
model PriceItem {
  code         String  @id
  name         String
  description  String?
  priceCzk     Int
  durationDays Int?
  active       Boolean @default(true)
}

/// Fotka ve zprávě – nahraná přes naše úložiště do konkrétní konverzace. Zpráva smí odkazovat jen na takovou přílohu.
model MessageAttachment {
  id             String        @id @default(cuid())
  ownerId        String
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?       @unique
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url            String
  width          Int
  height         Int
  createdAt      DateTime      @default(now())

  @@index([ownerId, createdAt])
}

/// Nastavení zpráv uživatele (odděleně od User)
model MessagePreference {
  userId         String   @id
  emailOnMessage Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}
