generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Role a jejich oprávnění: packages/shared/src/permissions.ts (ROLE_PERMISSIONS)
enum Role {
  USER
  MODERATOR
  ADMIN
  SUPERADMIN
  SUPPORT
  BUSINESS_MANAGER
}

/// RESTRICTED = automaticky nebo ručně omezený účet (nesmí zveřejňovat ani psát zprávy), čeká na kontrolu moderátorem.
enum UserStatus {
  ACTIVE
  BLOCKED
  RESTRICTED
}

enum ListingStatus {
  DRAFT
  PENDING
  ACTIVE
  RESERVED
  SOLD
  EXPIRED
  REJECTED
  DELETED
}

enum Condition {
  NEW
  LIKE_NEW
  USED
  DAMAGED
}

enum OfferType {
  SELL
  BUY
  EXCHANGE
  GIVE
  RENT
}

enum ReportTarget {
  LISTING
  USER
  MESSAGE
  CONVERSATION
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum TokenType {
  EMAIL_VERIFY
  PHONE_VERIFY
  PASSWORD_RESET
  EMAIL_CHANGE
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String?
  name            String
  phone           String?
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  googleId        String?    @unique
  appleId         String?    @unique
  avatarUrl       String?
  bio             String?
  city            String?
  region          String?
  isBusiness      Boolean    @default(false)
  companyName     String?
  companyId       String? // IČO
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lastSeenAt      DateTime?
  /// Souhlas s podmínkami při registraci (čas a verze podmínek)
  termsAcceptedAt DateTime?
  termsVersion    String?
  /// Uzamčení účtu po opakovaných chybných heslech (nezávisle na IP)
  failedLogins      Int       @default(0)
  lastFailedLoginAt DateTime?
  lockedUntil       DateTime?
  /// Telefon se u inzerátů ukáže jen s výslovným souhlasem (a jen ověřený)
  showPhone         Boolean   @default(false)
  /// Firma ověřená v registru ARES (obchodní jméno a sídlo z ARES)
  companyVerifiedAt DateTime?
  companyAddress    String?
  vatId             String? // DIČ
  /// Poslední aktivita (zapisuje AuthGuard nejvýše jednou za 10 minut) – pro DAU/WAU/MAU
  lastActiveAt      DateTime?
  /// Účet převzatý ze starého webu www.dejinzerat.cz (např. „dejinzerat:204“) a kdy mu odešla pozvánka
  legacyId          String?   @unique
  legacyInvitedAt   DateTime?
  /// Kdy partner (firemní účet s XML importem) dostal pozvánku k nastavení hesla
  partnerInvitedAt  DateTime?

  listings        Listing[]
  favorites       Favorite[]
  following       FollowSeller[]  @relation("follower")
  followers       FollowSeller[]  @relation("seller")
  savedSearches   SavedSearch[]
  buyerConvs      Conversation[]  @relation("buyer")
  sellerConvs     Conversation[]  @relation("seller")
  messages        Message[]
  blocks          Block[]         @relation("blocker")
  blockedBy       Block[]         @relation("blocked")
  reports         Report[]        @relation("reporter")
  reviewsGiven    Review[]        @relation("author")
  reviewsReceived Review[]        @relation("sellerReviews")
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  tokens          VerificationToken[]
  auditLogs       AuditLog[]
  partnerFeeds    PartnerFeed[]

  @@index([lastActiveAt])
}

model Category {
  id             String     @id @default(cuid())
  slug           String
  name           String
  icon           String?
  position       Int        @default(0)
  parentId       String?
  parent         Category?  @relation("tree", fields: [parentId], references: [id])
  children       Category[] @relation("tree")
  /// Definice filtrů/parametrů (FilterDef[]) – spravuje se v administraci
  filters        Json       @default("[]")
  active         Boolean    @default(true)
  seoTitle       String?
  seoDescription String?
  /// Úvodní (SEO) text kategorie zobrazený na její stránce
  intro          String?
  listings       Listing[]

  @@unique([parentId, slug])
  @@index([parentId])
}

model Listing {
  id               String        @id @default(cuid())
  slug             String
  title            String
  description      String
  price            Int?
  priceNegotiable  Boolean       @default(false)
  currency         String        @default("CZK")
  /// Cena přepočtená na Kč (EUR podle nastavení eurRate) – pro řazení a filtr ceny; udržuje aplikace
  priceCzk         Int?
  condition        Condition?
  offerType        OfferType     @default(SELL)
  status           ListingStatus @default(ACTIVE)
  rejectReason     String?
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  city             String
  region           String
  zip              String?
  lat              Float?
  lng              Float?
  /// Hodnoty parametrů kategorie, např. {"brand":"Škoda","year":2018}
  attributes       Json          @default("{}")
  videoUrl         String?
  views            Int           @default(0)
  spamScore        Int           @default(0)
  publishedAt      DateTime?
  expiresAt        DateTime?
  expiryNotifiedAt DateTime?
  bumpedAt         DateTime?
  highlightedUntil DateTime?
  topUntil         DateTime?
  /// Doba vyplnění průvodce od otevření po zveřejnění (s)
  composeSeconds   Int?
  /// Otisk normalizovaného názvu a popisu pro hledání duplicit
  contentHash      String?
  /// Důvody automatické kontroly (pro moderátora)
  riskReasons      Json          @default("[]")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  /// Normalizovaný text pro hledání (malá písmena bez diakritiky: název + popis + parametry + město),
  /// udržuje aplikace (buildSearchText v @dej/shared); GIN trigram index pro hledání v PostgreSQL
  searchText       String        @default("")
  /// Inzerát převzatý ze starého webu (UUID inzerátu tam) a otisk dat, která import naposledy zapsal
  legacyId         String?       @unique
  legacyHash       String?
  /// Inzerát z XML feedu partnera: feed, ID položky ve feedu a otisk dat (zdroj:zapsáno) – import podle nich nic nezdvojí
  feedId           String?
  feed             PartnerFeed?  @relation(fields: [feedId], references: [id], onDelete: SetNull)
  feedItemId       String?
  feedHash         String?
  /// Odkaz na nabídku na webu partnera (u inzerátu „Nabídka na webu prodejce“)
  sourceUrl        String?

  images        ListingImage[]
  favorites     Favorite[]
  conversations Conversation[]

  @@index([status, categoryId])
  @@index([userId, status])
  @@index([expiresAt])
  @@index([contentHash])
  @@index([status, publishedAt])
  @@index([lat, lng])
  @@index([status, priceCzk])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@unique([feedId, feedItemId])
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  ownerId   String
  url       String
  thumbUrl  String
  width     Int
  height    Int
  position  Int     @default(0)
  /// Percepční otisk fotky (dHash, 64 bitů) pro hledání znovu použitých fotek
  phash     BigInt?
  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([phash])
}

model Favorite {
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
  @@index([listingId])
}

model FollowSeller {
  followerId String
  sellerId   String
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  seller     User     @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, sellerId])
}

model SavedSearch {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  /// Parametry hledání (q, category, priceMin, priceMax, city, radius, …)
  query          Json
  notify         Boolean   @default(true)
  lastCheckedAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model Conversation {
  id            String    @id @default(cuid())
  /// Bez inzerátu = konverzace zahájená z profilu uživatele
  listingId     String?
  listing       Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  /// Jen u konverzací bez inzerátu: "menšíId:většíId" – jedna přímá konverzace na dvojici uživatelů
  directKey     String?   @unique
  buyerId       String
  buyer         User      @relation("buyer", fields: [buyerId], references: [id])
  sellerId      String
  seller        User      @relation("seller", fields: [sellerId], references: [id])
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  /// Archivace zvlášť pro každého účastníka
  buyerArchivedAt  DateTime?
  sellerArchivedAt DateTime?
  messages      Message[]
  reviews       Review[]
  attachments   MessageAttachment[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  imageUrl       String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  attachment     MessageAttachment?

  @@index([conversationId, createdAt])
}

model Block {
  blockerId String
  blockedId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  reporter     User         @relation("reporter", fields: [reporterId], references: [id])
  targetType   ReportTarget
  targetId     String
  /// Konverzace, které se hlášení týká (CONVERSATION a MESSAGE) – moderátor ji smí zobrazit jen ke čtení
  conversationId String?
  reason       String
  note         String?
  status       ReportStatus @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  /// Poznámka moderátora k vyřízení (vidí ji i oznamovatel v notifikaci)
  resolutionNote String?
  createdAt    DateTime     @default(now())

  @@index([status])
  @@index([targetType, targetId])
}

/// Hodnocení je možné jen po skutečné konverzaci (vazba na Conversation).
model Review {
  id             String       @id @default(cuid())
  authorId       String
  author         User         @relation("author", fields: [authorId], references: [id])
  sellerId       String
  seller         User         @relation("sellerReviews", fields: [sellerId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  rating         Int
  text           String?
  createdAt      DateTime     @default(now())

  @@unique([authorId, conversationId])
  @@index([sellerId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  /// Zařízení pro přehled přihlášení v nastavení
  userAgent  String?
  ip         String?
  lastUsedAt DateTime?

  @@index([userId])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  /// Ověřovaná hodnota (nové telefonní číslo nebo nový e-mail)
  target    String?
  /// Počet chybně zadaných kódů
  attempts  Int       @default(0)

  @@index([userId, type])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

/// Informační stránky (Podmínky, GDPR, Nápověda…) – editovatelné v administraci
model Page {
  slug          String    @id
  title         String
  content       String
  updatedAt     DateTime  @updatedAt
  /// Meta popis pro vyhledávače
  description   String?
  /// Účinnost znění (u právních dokumentů)
  effectiveFrom DateTime?
  /// Datum kontroly právníkem (prázdné = text je jen návrh)
  reviewedAt    DateTime?
  /// Otisk obsahu vloženého seedem – seed smí text aktualizovat jen dokud ho nikdo neupravil
  seededHash    String?
}

/// Ceník placených služeb (topování, zvýraznění…) – nastavitelný v administraci (fáze 2: platby)
model PriceItem {
  code         String  @id
  name         String
  description  String?
  priceCzk     Int
  durationDays Int?
  active       Boolean @default(true)
}

/// Fotka ve zprávě – nahraná přes naše úložiště do konkrétní konverzace. Zpráva smí odkazovat jen na takovou přílohu.
model MessageAttachment {
  id             String        @id @default(cuid())
  ownerId        String
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?       @unique
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url            String
  width          Int
  height         Int
  createdAt      DateTime      @default(now())

  @@index([ownerId, createdAt])
}

/// Nastavení zpráv uživatele (odděleně od User)
model MessagePreference {
  userId         String   @id
  emailOnMessage Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

/// Systémová nastavení editovatelná v administraci (klíče a výchozí hodnoty: apps/api/src/admin/settings.service.ts)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Historie omezení účtů (automatických i ručních). Aktivní omezení = liftedAt je null a User.status = RESTRICTED.
model UserRestriction {
  id         String    @id @default(cuid())
  userId     String
  /// 'auto' = automat (nahlášení, rizikový obsah), 'staff' = ručně
  source     String
  reason     String
  createdAt  DateTime  @default(now())
  liftedAt   DateTime?
  liftedById String?
  liftNote   String?

  @@index([userId, createdAt])
  @@index([liftedAt])
}

/// Přesměrování starých adres (změněné slugy kategorií, staré URL) – spravuje se v administraci
model Redirect {
  from      String   @id
  to        String
  code      Int      @default(308)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
}

enum NoticeStatus {
  RECEIVED
  ACTION_TAKEN
  NO_ACTION
}

/// Oznámení nezákonného obsahu podle čl. 16 nařízení (EU) 2022/2065 (DSA) – lze podat i bez účtu
model IllegalContentNotice {
  id             String        @id @default(cuid())
  /// Číslo oznámení pro oznamovatele (potvrzení o přijetí)
  ref            String        @unique
  category       String
  targetUrl      String
  targetType     ReportTarget?
  targetId       String?
  explanation    String
  reporterName   String?
  reporterEmail  String?
  reporterUserId String?
  goodFaith      Boolean
  status         NoticeStatus  @default(RECEIVED)
  /// Přijaté opatření (none | reject | delete) a odůvodnění rozhodnutí (čl. 17 DSA)
  action         String?
  decisionReason String?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime      @default(now())

  @@index([status, createdAt])
}

enum AppealStatus {
  OPEN
  UPHELD
  REJECTED
}

/// Stížnost uživatele proti rozhodnutí moderace (vnitřní systém vyřizování stížností, čl. 20 DSA)
model ModerationAppeal {
  id             String       @id @default(cuid())
  ref            String       @unique
  listingId      String
  userId         String
  text           String
  status         AppealStatus @default(OPEN)
  decisionReason String?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([status, createdAt])
  @@index([listingId])

}

/// Partner s bezplatným automatickým importem nabídek přes XML feed (autobazar, realitní kancelář, e-shop).
/// Inzeráty se zobrazují pod firemním účtem partnera (userId). Postup: apps/api/src/feeds, docs/XML-IMPORT-PARTNERU.md
model PartnerFeed {
  id                String    @id @default(cuid())
  /// Název pro administraci (např. „Autobazar Novák“)
  name              String
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  url               String
  /// auto | heureka | google | generic (auto = rozpozná se podle obsahu)
  format            String    @default("auto")
  /// Ruční přiřazení polí feedu ({ title: "PRODUCTNAME", brand: "param:Značka" }) – co chybí, doplní se automaticky
  fieldMap          Json      @default("{}")
  /// Kategorie feedu → ID naší podkategorie ({ "Elektronika | Mobilní telefony": "<categoryId>" })
  categoryMap       Json      @default("{}")
  /// Kategorie pro položky, které nejde přiřadit (jinak Ostatní › Různé)
  defaultCategoryId String?
  /// Místo pro položky bez adresy (např. sídlo autobazaru)
  defaultCity       String?
  defaultZip        String?
  /// Nové inzeráty čekají na schválení moderátorem (doporučeno, dokud partnerovi nedůvěřujete)
  requireApproval   Boolean   @default(true)
  /// Interval automatické synchronizace v hodinách (0 = jen ručně)
  intervalHours     Int       @default(24)
  /// Nejvýše tolik položek z feedu (ochrana před omylem obřím feedem)
  maxItems          Int       @default(1000)
  active            Boolean   @default(true)
  lastSyncAt        DateTime?
  /// ok | partial | error
  lastStatus        String?
  lastMessage       String?
  nextSyncAt        DateTime?
  /// Rozpracovaná synchronizace (pokračuje v další dávce)
  currentRunId      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  listings          Listing[]
  runs              PartnerFeedRun[]

  @@index([active, nextSyncAt])
}

/// Historie synchronizací feedu (ruční i automatické)
model PartnerFeedRun {
  id         String      @id @default(cuid())
  feedId     String
  feed       PartnerFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  /// manual | schedule
  trigger    String
  startedAt  DateTime    @default(now())
  finishedAt DateTime?
  /// running | ok | partial | error
  status     String      @default("running")
  items      Int         @default(0)
  created    Int         @default(0)
  updated    Int         @default(0)
  unchanged  Int         @default(0)
  removed    Int         @default(0)
  skipped    Int         @default(0)
  errors     Int         @default(0)
  message    String?
  /// Ukázka problémů (nejvýše 50): [{ id, title, message }]
  problems   Json        @default("[]")

  @@index([feedId, startedAt])
}
