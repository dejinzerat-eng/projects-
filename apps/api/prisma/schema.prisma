generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum ListingStatus {
  DRAFT
  PENDING
  ACTIVE
  RESERVED
  SOLD
  EXPIRED
  REJECTED
  DELETED
}

enum Condition {
  NEW
  LIKE_NEW
  USED
  DAMAGED
}

enum OfferType {
  SELL
  BUY
  EXCHANGE
  GIVE
  RENT
}

enum ReportTarget {
  LISTING
  USER
  MESSAGE
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum TokenType {
  EMAIL_VERIFY
  PHONE_VERIFY
  PASSWORD_RESET
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String?
  name            String
  phone           String?
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  googleId        String?    @unique
  appleId         String?    @unique
  avatarUrl       String?
  bio             String?
  city            String?
  region          String?
  isBusiness      Boolean    @default(false)
  companyName     String?
  companyId       String? // IČO
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lastSeenAt      DateTime?

  listings        Listing[]
  favorites       Favorite[]
  following       FollowSeller[]  @relation("follower")
  followers       FollowSeller[]  @relation("seller")
  savedSearches   SavedSearch[]
  buyerConvs      Conversation[]  @relation("buyer")
  sellerConvs     Conversation[]  @relation("seller")
  messages        Message[]
  blocks          Block[]         @relation("blocker")
  blockedBy       Block[]         @relation("blocked")
  reports         Report[]        @relation("reporter")
  reviewsGiven    Review[]        @relation("author")
  reviewsReceived Review[]        @relation("sellerReviews")
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  tokens          VerificationToken[]
  auditLogs       AuditLog[]
}

model Category {
  id             String     @id @default(cuid())
  slug           String
  name           String
  icon           String?
  position       Int        @default(0)
  parentId       String?
  parent         Category?  @relation("tree", fields: [parentId], references: [id])
  children       Category[] @relation("tree")
  /// Definice filtrů/parametrů (FilterDef[]) – spravuje se v administraci
  filters        Json       @default("[]")
  active         Boolean    @default(true)
  seoTitle       String?
  seoDescription String?
  /// Úvodní (SEO) text kategorie zobrazený na její stránce
  intro          String?
  listings       Listing[]

  @@unique([parentId, slug])
  @@index([parentId])
}

model Listing {
  id               String        @id @default(cuid())
  slug             String
  title            String
  description      String
  price            Int?
  priceNegotiable  Boolean       @default(false)
  currency         String        @default("CZK")
  condition        Condition?
  offerType        OfferType     @default(SELL)
  status           ListingStatus @default(ACTIVE)
  rejectReason     String?
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  city             String
  region           String
  zip              String?
  lat              Float?
  lng              Float?
  /// Hodnoty parametrů kategorie, např. {"brand":"Škoda","year":2018}
  attributes       Json          @default("{}")
  videoUrl         String?
  views            Int           @default(0)
  spamScore        Int           @default(0)
  publishedAt      DateTime?
  expiresAt        DateTime?
  expiryNotifiedAt DateTime?
  bumpedAt         DateTime?
  highlightedUntil DateTime?
  topUntil         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  images        ListingImage[]
  favorites     Favorite[]
  conversations Conversation[]

  @@index([status, categoryId])
  @@index([userId, status])
  @@index([expiresAt])
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  ownerId   String
  url       String
  thumbUrl  String
  width     Int
  height    Int
  position  Int     @default(0)
  createdAt DateTime @default(now())

  @@index([listingId])
}

model Favorite {
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
}

model FollowSeller {
  followerId String
  sellerId   String
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  seller     User     @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, sellerId])
}

model SavedSearch {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  /// Parametry hledání (q, category, priceMin, priceMax, city, radius, …)
  query          Json
  notify         Boolean   @default(true)
  lastCheckedAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
}

model Conversation {
  id            String    @id @default(cuid())
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User      @relation("buyer", fields: [buyerId], references: [id])
  sellerId      String
  seller        User      @relation("seller", fields: [sellerId], references: [id])
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  messages      Message[]
  reviews       Review[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  imageUrl       String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Block {
  blockerId String
  blockedId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  reporter     User         @relation("reporter", fields: [reporterId], references: [id])
  targetType   ReportTarget
  targetId     String
  reason       String
  note         String?
  status       ReportStatus @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([status])
}

/// Hodnocení je možné jen po skutečné konverzaci (vazba na Conversation).
model Review {
  id             String       @id @default(cuid())
  authorId       String
  author         User         @relation("author", fields: [authorId], references: [id])
  sellerId       String
  seller         User         @relation("sellerReviews", fields: [sellerId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  rating         Int
  text           String?
  createdAt      DateTime     @default(now())

  @@unique([authorId, conversationId])
  @@index([sellerId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Informační stránky (Podmínky, GDPR, Nápověda…) – editovatelné v administraci
model Page {
  slug          String    @id
  title         String
  content       String
  updatedAt     DateTime  @updatedAt
  /// Meta popis pro vyhledávače
  description   String?
  /// Účinnost znění (u právních dokumentů)
  effectiveFrom DateTime?
  /// Datum kontroly právníkem (prázdné = text je jen návrh)
  reviewedAt    DateTime?
  /// Otisk obsahu vloženého seedem – seed smí text aktualizovat jen dokud ho nikdo neupravil
  seededHash    String?
}

/// Ceník placených služeb (topování, zvýraznění…) – nastavitelný v administraci (fáze 2: platby)
model PriceItem {
  code         String  @id
  name         String
  description  String?
  priceCzk     Int
  durationDays Int?
  active       Boolean @default(true)
}

/// Přesměrování starých adres (změněné slugy kategorií, staré URL) – spravuje se v administraci
model Redirect {
  from      String   @id
  to        String
  code      Int      @default(308)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
}

enum NoticeStatus {
  RECEIVED
  ACTION_TAKEN
  NO_ACTION
}

/// Oznámení nezákonného obsahu podle čl. 16 nařízení (EU) 2022/2065 (DSA) – lze podat i bez účtu
model IllegalContentNotice {
  id             String        @id @default(cuid())
  /// Číslo oznámení pro oznamovatele (potvrzení o přijetí)
  ref            String        @unique
  category       String
  targetUrl      String
  targetType     ReportTarget?
  targetId       String?
  explanation    String
  reporterName   String?
  reporterEmail  String?
  reporterUserId String?
  goodFaith      Boolean
  status         NoticeStatus  @default(RECEIVED)
  /// Přijaté opatření (none | reject | delete) a odůvodnění rozhodnutí (čl. 17 DSA)
  action         String?
  decisionReason String?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime      @default(now())

  @@index([status, createdAt])
}

enum AppealStatus {
  OPEN
  UPHELD
  REJECTED
}

/// Stížnost uživatele proti rozhodnutí moderace (vnitřní systém vyřizování stížností, čl. 20 DSA)
model ModerationAppeal {
  id             String       @id @default(cuid())
  ref            String       @unique
  listingId      String
  userId         String
  text           String
  status         AppealStatus @default(OPEN)
  decisionReason String?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([status, createdAt])
  @@index([listingId])
}
